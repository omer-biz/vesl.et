---
import { Image } from 'astro:assets';

const { name, description, tech, image, src, demo } = Astro.props;
---

<article class="group border border-stone-400/30 dark:border-stone-700/30 bg-stone-300/20 dark:bg-stone-800/20 rounded-sm overflow-hidden flex flex-col md:flex-row h-full transition-all hover:border-amber-600/50 dark:hover:border-amber-500/50 hover:bg-stone-300/40 dark:hover:bg-stone-800/40">
  <div class="md:w-48 w-full h-48 md:h-auto shrink-0 border-b md:border-b-0 md:border-r border-stone-400/30 dark:border-stone-700/30 overflow-hidden">
      <Image
          src={image} 
          alt={`Screenshot of ${name}`} 
          class="w-full h-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0 group-hover:scale-105"
      />
  </div>

  <div class="p-6 flex flex-col justify-between flex-grow">
    <div>
      <div class="flex justify-between items-start mb-2">
        <h3 class="text-xl font-bold text-stone-800 dark:text-stone-200">{name}</h3>
        <div class="flex gap-3 text-sm">
          {src && <a href={src} target="_blank" rel="noopener noreferrer" class="text-orange-800 dark:text-orange-400 hover:text-teal-700 dark:hover:text-teal-400 font-bold">[src]</a>}
          {demo && <a href={demo} target="_blank" rel="noopener noreferrer" class="text-orange-800 dark:text-orange-400 hover:text-teal-700 dark:hover:text-teal-400 font-bold">[live]</a>}
        </div>
      </div>

      <p class="text-stone-600 dark:text-stone-400 text-sm leading-relaxed mb-4">
        {description}
      </p>
    </div>

    <div class="flex flex-wrap gap-2 mt-auto">
      {tech.map((item) => (
        <span class="text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 bg-stone-800 text-stone-200 rounded-sm">
          {item}
        </span>
      ))}
    </div>
  </div>
</article>
