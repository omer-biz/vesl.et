---
import { Image } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PostPreview from "../components/PostPreview.astro";
import Footer from "../components/Footer.astro";
import Email from "../components/Email.astro";
import ProjectCard from "../components/ProjectCard.astro";
import GithubTracker from "../components/GithubTracker.jsx";

import profile from "../assets/profile.jpg";
import getLogsCollection from "../lib/logsCollection";
import { getCollection } from "astro:content";

const latestLogs = (await getLogsCollection())
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 4);

const projects = await getCollection("projects");

const ossContributions = [
  {
    repo: "pest-parser",
    url: "https://github.com/pest-parser",
    description: "Moved parser execution to a Web Worker, added rule states, and improved documentation.",
    prs: [
      { title: "#69", url: "https://github.com/pest-parser/site/pull/69" },
      { title: "#65", url: "https://github.com/pest-parser/site/pull/65" },
      { title: "#64", url: "https://github.com/pest-parser/site/pull/64" },
    ]
  },
  {
    repo: "ratatui",
    url: "https://github.com/ratatui/ratatui-website",
    description: "Documentation improvements and typo fixes.",
    prs: [
      { title: "#156", url: "https://github.com/ratatui/ratatui-website/pull/156" },
      { title: "#150", url: "https://github.com/ratatui/ratatui-website/pull/150" },
      { title: "#118", url: "https://github.com/ratatui/ratatui-website/pull/118" },
    ]
  },
  {
    repo: "picterm",
    url: "https://github.com/ksk001100/picterm",
    description: "Added circular scrolling and search functionality to the terminal image viewer.",
    prs: [
      { title: "#7", url: "https://github.com/ksk001100/picterm/pull/7" },
      { title: "#5", url: "https://github.com/ksk001100/picterm/pull/5" },
    ]
  }
];
---

<BaseLayout>
    <Header />

    <main class="mb-8">
        <div class="flex flex-col md:flex-row gap-8 items-start mb-8">
            <figure class="shrink-0">
                <Image
                    src={profile}
                    alt="Omer's profile picture"
                    class="w-32 h-32 md:w-40 md:h-40 object-cover rounded-sm border-2 border-stone-400/50 dark:border-stone-700/50 p-1 bg-stone-100 dark:bg-stone-900 shadow-sm"
                />
            </figure>

            <div>
                <h1 class="text-2xl md:text-3xl font-bold leading-snug">
                    Welcome,
                    <span class="text-teal-800 dark:text-teal-300 bg-teal-800/5 dark:bg-teal-400/10 px-1 rounded-sm"
                        >wanderer</span
                    >. I'm
                    <span class="text-green-800 dark:text-green-400 bg-green-800/5 dark:bg-green-400/10 px-1 rounded-sm"
                        >Omer</span
                    >, and this is my digital
                    <span class="text-blue-800 dark:text-blue-400 bg-blue-800/5 dark:bg-blue-400/10 px-1 rounded-sm"
                        >vessel</span
                    >. Thanks for dropping
                    <span class="text-red-800 dark:text-red-400 bg-red-800/5 dark:bg-red-400/10 px-1 rounded-sm"
                        >anchor</span
                    >.
                </h1>
            </div>
        </div>

        <p class="text-lg text-stone-600 dark:text-stone-400 leading-relaxed max-w-2xl">
            My history with computers goes back to when I was five, watching my
            uncles figure out how Paint works on Windows XP. Now, I’m not
            satisfied until I understand every aspect of the technology I’m
            working on.
        </p>

        <section class="mb-12 mt-8">
            <h2
                class="text-lg font-bold mb-4 flex items-center uppercase tracking-widest text-stone-600 dark:text-stone-400"
            >
                <span class="text-amber-600 dark:text-amber-500 mr-2">::</span> Contributions
            </h2>
            <div
                class="w-full max-w-4xl opacity-100 transition-opacity"
            >
                <GithubTracker client:visible />
            </div>
            
            <div class="mt-8 pt-8 border-t border-stone-300 dark:border-stone-700/50">
                <h3 class="text-sm font-bold uppercase tracking-widest text-stone-500 dark:text-stone-400 mb-6"><span class="text-amber-600 dark:text-amber-500 mr-2">*</span> Notable Pull Requests</h3>
                <ul class="space-y-6">
                    {ossContributions.map(oss => (
                        <li class="flex flex-col gap-2">
                            <div class="flex flex-col md:flex-row md:items-baseline gap-1 md:gap-2">
                                <a href={oss.url} target="_blank" rel="noopener noreferrer" class="font-bold text-orange-800 dark:text-orange-400 hover:text-teal-700 dark:hover:text-teal-400 hover:underline underline-offset-4 decoration-2 shrink-0 text-base md:text-lg">
                                    {oss.repo}
                                </a>
                                <span class="text-stone-400 dark:text-stone-500 hidden md:inline">—</span>
                                <span class="text-sm text-stone-600 dark:text-stone-400 leading-relaxed">
                                    {oss.description}
                                </span>
                            </div>
                            <div class="flex flex-wrap items-center gap-2 text-xs font-bold text-stone-500 dark:text-stone-400">
                                <span class="uppercase tracking-widest text-[10px]">PRs:</span>
                                {oss.prs.map((pr, index) => (
                                    <span class="flex items-center">
                                        <a href={pr.url} target="_blank" rel="noopener noreferrer" class="hover:text-teal-700 dark:hover:text-teal-400 transition-colors">
                                            [{pr.title}]
                                        </a>
                                        {index !== oss.prs.length - 1 && <span class="text-stone-300 dark:text-stone-700 ml-2">/</span>}
                                    </span>
                                ))}
                            </div>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <div class="mb-8 flex flex-col items-center justify-center space-y-4">
            <div class="items-center gap-6">
                <p>
                    <a
                        href="https://github.com/omer-biz"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group relative text-lg font-bold text-orange-800 dark:text-orange-400 hover:text-teal-700 dark:hover:text-teal-400 transition-colors flex items-center gap-2"
                    >
                        <span
                            class="text-stone-600 dark:text-stone-400 text-sm font-bold tracking-widest"
                            >github:</span
                        >
                        <span class="font-mono">[@omer-biz]</span>

                        <span
                            class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100
                            absolute bottom-[130%] left-1/2 -translate-x-1/2
                            bg-stone-800 text-stone-100 text-xs py-1 px-3 rounded
                            transition-all duration-200 pointer-events-none whitespace-nowrap
                            after:content-[''] after:absolute after:top-full after:left-1/2 after:-ml-1 after:border-4 after:border-transparent after:border-t-stone-800"
                        >
                            checkout omer's cool github
                        </span>
                    </a>
                </p>
                <Email />
            </div>
        </div>

        <section class="mb-12">
            <h2
                class="text-lg font-bold mb-8 flex items-center uppercase tracking-widest text-stone-600 dark:text-stone-400"
            >
                <span class="text-amber-600 dark:text-amber-500 mr-2">::</span> Projects
            </h2>

            <div class="grid grid-cols-1 gap-8">
                {
                    projects.map((project) => (
                        <ProjectCard
                            name={project.data.name}
                            description={project.data.description}
                            tech={project.data.tech}
                            image={project.data.image}
                            src={project.data.src}
                            demo={project.data.demo}
                        />
                    ))
                }
            </div>
        </section>

        <section>
            <h2
                class="text-lg font-bold mb-8 flex items-center uppercase tracking-widest text-stone-600 dark:text-stone-400"
            >
                <span class="text-amber-600 dark:text-amber-500 mr-2">::</span> Logs
            </h2>
            <ul class="space-y-6">
                {
                    latestLogs.map((log) => (
                        <PostPreview
                            title={log.data.title}
                            url={`/logs/${log.id}`}
                            date={log.data.pubDate.toISOString()}
                            tags={log.data.tags}
                        />
                    ))
                }
            </ul>
            <div class="mt-12">
                <a
                    href="/logs"
                    class="text-sm hover:text-orange-800 dark:hover:text-orange-400 hover:underline underline-offset-4 decoration-2"
                >
                    [ view all archives -> ]
                </a>
            </div>
        </section>
    </main>
    <Footer />
</BaseLayout>
