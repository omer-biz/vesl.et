---
import VeslDef from './VeslDef.astro';
---

<header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 border-b border-stone-400/30 dark:border-stone-700/30 pb-6">
    <div class="mb-4 md:mb-0">
        <h1 class="text-xl font-bold tracking-tight text-orange-800 dark:text-orange-400">
            <VeslDef term="vesl.et" position="bottom">
                <a href="/" class="hover:text-orange-900 dark:hover:text-orange-300 transition-colors">
                    <span class="text-stone-600 dark:text-stone-400 mr-1">$</span> vesl.et
                </a>
            </VeslDef>
        </h1>
    </div>
    <nav class="flex items-center space-x-6 text-sm lowercase">
        <a href="/logs" class="hover:text-teal-700 dark:hover:text-teal-400 hover:underline underline-offset-4 decoration-2">[logs]</a>
        <a href="/categories" class="hover:text-teal-700 dark:hover:text-teal-400 hover:underline underline-offset-4 decoration-2">[categories]</a>
        <a href="/rss.xml" class="hover:text-teal-700 dark:hover:text-teal-400 hover:underline underline-offset-4 decoration-2">[rss]</a>
        <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="hover:text-teal-700 dark:hover:text-teal-400 hover:underline underline-offset-4 decoration-2">[resume]</a>
        <button id="theme-toggle" aria-label="Toggle dark mode" class="text-stone-500 hover:text-teal-700 dark:text-stone-400 dark:hover:text-teal-400 transition-colors cursor-pointer flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block">
                <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
            </svg>
        </button>
    </nav>
    <script>
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        document.documentElement.classList.add('theme-transition');
        
        document.documentElement.classList.toggle('dark');
        const isDark = document.documentElement.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        
        // Remove the transition class after the animation completes
        setTimeout(() => {
          document.documentElement.classList.remove('theme-transition');
        }, 400);
      });
    </script>
</header>
